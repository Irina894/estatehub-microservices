<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <!-- RabbitMQ.Client 7.x: повністю асинхронний API (IChannel, BasicPublishAsync ...) -->
    <PackageReference Include="RabbitMQ.Client" Version="7.2.2" />
    <!-- Aspire-інтеграція: реєструє IConnection, health check і телеметрію (AddRabbitMQClient) -->
    <PackageReference Include="Aspire.RabbitMQ.Client" Version="13.6.4" />
    <!-- Пропагатор W3C traceparent -->
    <PackageReference Include="OpenTelemetry.Api" Version="1.17.0" />
  </ItemGroup>

</Project>
