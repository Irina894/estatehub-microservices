{
  "ConnectionStrings": {
    "CatalogDb": "Server=(localdb)\\mssqllocaldb;Database=EstateHub_Catalog_EF;AttachDbFileName=C:\\Users\\Public\\EstateHub_Catalog_EF.mdf;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Database": {
    "ApplyMigrations": true,
    "Seed": true
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [{CorrelationId}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/catalog-.log",
          "rollingInterval": "Day",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} [{Level:u3}] [{CorrelationId}] [{UserId}] [{RequestPath}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ],
    "Properties": { "Application": "Catalog.Api" }
  },
  "AllowedHosts": "*"
}
